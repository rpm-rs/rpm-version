from typing import ClassVar, final

__all__ = [
    "Evr",
    "Nevra",
    "ReqOperator",
    "Requirement",
    "EvrSortKey",
    "evr_compare",
    "evr_sort",
    "nevra_sort",
    "version_sortkey",
]

@final
class Evr:
    def __new__(cls, epoch: str | None, version: str, release: str) -> Evr: ...
    @classmethod
    def parse(cls, evr: str) -> Evr: ...
    @property
    def epoch(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def release(self) -> str: ...
    def evr(self) -> str: ...
    def evr_short(self) -> str: ...
    def sortkey(self) -> bytes: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Evr, /) -> bool: ...
    def __le__(self, other: Evr, /) -> bool: ...
    def __gt__(self, other: Evr, /) -> bool: ...
    def __ge__(self, other: Evr, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Nevra:
    def __new__(cls, name: str, epoch: str | None, version: str, release: str, arch: str) -> Nevra: ...
    @classmethod
    def parse(cls, nevra: str) -> Nevra: ...
    @property
    def name(self) -> str: ...
    @property
    def epoch(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def release(self) -> str: ...
    @property
    def arch(self) -> str: ...
    def evr(self) -> Evr: ...
    def nevra(self) -> str: ...
    def nevra_short(self) -> str: ...
    def nvra(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Nevra, /) -> bool: ...
    def __le__(self, other: Nevra, /) -> bool: ...
    def __gt__(self, other: Nevra, /) -> bool: ...
    def __ge__(self, other: Nevra, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class ReqOperator:
    LT: ClassVar[ReqOperator]
    LE: ClassVar[ReqOperator]
    EQ: ClassVar[ReqOperator]
    GE: ClassVar[ReqOperator]
    GT: ClassVar[ReqOperator]
    def __int__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Requirement:
    def __new__(cls, name: str, op: ReqOperator | str | None = None, evr: Evr | None = None) -> Requirement: ...
    @property
    def name(self) -> str: ...
    @property
    def constraint(self) -> tuple[ReqOperator, Evr] | None: ...
    def satisfies(self, name: str, evr: Evr) -> bool: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class EvrSortKey:
    @classmethod
    def from_values(cls, epoch: str | None, version: str, release: str) -> bytes: ...
    @classmethod
    def parse(cls, evr: str) -> bytes: ...

def evr_compare(evr1: str, evr2: str) -> int: ...
def evr_sort(evrs: list[str]) -> list[str]: ...
def nevra_sort(nevras: list[str]) -> list[str]: ...
def version_sortkey(version: str) -> bytes: ...
